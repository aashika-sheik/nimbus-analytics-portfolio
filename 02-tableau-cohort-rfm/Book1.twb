      <aliases enabled='yes' />
      <column caption='Cohort Month' datatype='datetime' name='[Calculation_1011580808359936]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, {FIXED [customer_id]: MIN([signup_date])})' />
      </column>
      <column caption='Months Since Signup' datatype='integer' name='[Calculation_1011580808536065]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [Calculation_1011580808359936], DATETRUNC(&apos;month&apos;, [order_date]))' />
      </column>
      <column caption='Recency (Days)' datatype='integer' name='[Calculation_1011580812574722]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, {FIXED [customer_id]: MAX([order_date])}, {MAX([order_date])})' />
      </column>
      <column caption='Frequency' datatype='integer' name='[Calculation_1011580812668931]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [customer_id]: COUNTD([order_id])}' />
      </column>
      <column caption='Monetary' datatype='real' name='[Calculation_1011580812849156]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [customer_id]: SUM([revenue])}' />
      </column>
