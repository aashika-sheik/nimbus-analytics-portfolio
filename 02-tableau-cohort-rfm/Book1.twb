  <worksheets>
    <worksheet name='Cohort Retention'>
      <table>
        <view>
          <datasources>
            <datasource caption='orders+' name='federated.1mm60hu1vs122o157fqsr0qib5vy' />
          </datasources>
          <datasource-dependencies datasource='federated.1mm60hu1vs122o157fqsr0qib5vy'>
            <column caption='Cohort Month' datatype='datetime' name='[Calculation_1011580808359936]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, {FIXED [customer_id]: MIN([signup_date])})' />
            </column>
            <column caption='Months Since Signup' datatype='integer' name='[Calculation_1011580808536065]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [Calculation_1011580808359936], DATETRUNC(&apos;month&apos;, [order_date]))' />
            </column>
            <column caption='Customer Id' datatype='string' name='[customer_id]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1011580808536065]' derivation='None' name='[none:Calculation_1011580808536065:qk]' pivot='key' type='quantitative' />
            <column caption='Order Date' datatype='date' name='[order_date]' role='dimension' type='ordinal' />
            <column-instance column='[customer_id]' derivation='CountD' name='[pcto:ctd:customer_id:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' type='PctTotal' />
            </column-instance>
            <column caption='Signup Date' datatype='date' name='[signup_date]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_1011580808359936]' derivation='Month-Trunc' name='[tmn:Calculation_1011580808359936:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Square' />
            <encodings>
              <text column='[federated.1mm60hu1vs122o157fqsr0qib5vy].[pcto:ctd:customer_id:qk]' />
            </encodings>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-cull' value='true' />
                <format attr='mark-labels-show' value='true' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.1mm60hu1vs122o157fqsr0qib5vy].[tmn:Calculation_1011580808359936:qk]</rows>
        <cols>[federated.1mm60hu1vs122o157fqsr0qib5vy].[none:Calculation_1011580808536065:qk]</cols>
      </table>
      <simple-id uuid='{DA8746D4-6429-4F32-A200-C1BBF6D6AA9D}' />
    </worksheet>
    <worksheet name='RFM Segmentation'>
      <table>
        <view>
          <datasources>
            <datasource caption='orders+' name='federated.1mm60hu1vs122o157fqsr0qib5vy' />
          </datasources>
          <datasource-dependencies datasource='federated.1mm60hu1vs122o157fqsr0qib5vy'>
            <column caption='Recency (Days)' datatype='integer' name='[Calculation_1011580812574722]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, {FIXED [customer_id]: MAX([order_date])}, {MAX([order_date])})' />
            </column>
            <column caption='Frequency' datatype='integer' name='[Calculation_1011580812668931]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [customer_id]: COUNTD([order_id])}' />
            </column>
            <column caption='Monetary' datatype='real' name='[Calculation_1011580812849156]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [customer_id]: SUM([revenue])}' />
            </column>
            <column-instance column='[Calculation_1011580812574722]' derivation='Avg' name='[avg:Calculation_1011580812574722:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1011580812668931]' derivation='Avg' name='[avg:Calculation_1011580812668931:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1011580812849156]' derivation='Avg' name='[avg:Calculation_1011580812849156:qk]' pivot='key' type='quantitative' />
            <column caption='Customer Id' datatype='string' name='[customer_id]' role='dimension' type='nominal' />
            <column-instance column='[customer_id]' derivation='None' name='[none:customer_id:nk]' pivot='key' type='nominal' />
            <column caption='Order Date' datatype='date' name='[order_date]' role='dimension' type='ordinal' />
            <column caption='Order Id' datatype='string' name='[order_id]' role='dimension' type='nominal' />
            <column caption='Revenue' datatype='real' name='[revenue]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <encodings>
              <color column='[federated.1mm60hu1vs122o157fqsr0qib5vy].[avg:Calculation_1011580812574722:qk]' />
              <lod column='[federated.1mm60hu1vs122o157fqsr0qib5vy].[none:customer_id:nk]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.1mm60hu1vs122o157fqsr0qib5vy].[avg:Calculation_1011580812849156:qk]</rows>
